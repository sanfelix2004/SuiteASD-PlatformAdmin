{
  "name": "suiteasd-platform-admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "env -u DATABASE_URL next dev -H 127.0.0.1 -p 3847",
    "build": "next build && node scripts/migrate.mjs",
    "start": "next start -H 127.0.0.1 -p 3847",
    "lint": "next lint",
    "db:migrate": "prisma migrate dev",
    "db:seed": "env -u DATABASE_URL tsx scripts/seed.ts",
    "postinstall": "echo skip-prisma"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@prisma/client": "^6.16.3",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "jose": "^6.2.18",
    "lucide-react": "^1.76.0",
    "next": "^15.5.29",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.1.0",
    "postcss": "^8",
    "prisma": "^6.16.3",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
